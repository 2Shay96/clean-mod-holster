<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><OutputType>Exe</OutputType><UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems><ApplicationIcon>../../src/app.ico</ApplicationIcon>
    <DefineConstants>UI_TESTS</DefineConstants><StartupObject>RDR2ModHolster.UiChecks</StartupObject><ApplicationManifest>../../src/app.manifest</ApplicationManifest><AppConfig>../../src/App.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/UI/*.cs" />
    <Compile Include="../../src/Safety/SafetyEngine.cs" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" /><Reference Include="System.Xml.Linq" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../src/Assets/sunrise.png" LogicalName="RDR2ModHolster.sunrise.png" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/Assets/Icons/*.svg" LogicalName="RDR2ModHolster.Icon.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/Assets/Lettering/clean-title.svg" LogicalName="RDR2ModHolster.clean-title.svg" />
    <EmbeddedResource Include="../../src/Assets/Lettering/clean-subtitle.svg" LogicalName="RDR2ModHolster.clean-subtitle.svg" />
  </ItemGroup>
</Project>
