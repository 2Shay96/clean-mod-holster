    <AssemblyName>CleanKeyboardReview</AssemblyName><ApplicationIcon>../../src/app.ico</ApplicationIcon><AppConfig>../../src/App.config</AppConfig><ApplicationManifest>../../src/app.manifest</ApplicationManifest>
    <ProductionAssembly Condition="'$(ProductionAssembly)' == ''">../../src/bin/Release/net48/CLEAN_v3.2.exe</ProductionAssembly>
